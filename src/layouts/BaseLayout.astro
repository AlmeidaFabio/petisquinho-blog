---
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Caminho absoluto a partir da raiz, ex.: /og/meu-post.jpg */
  ogImage?: string;
  ogType?: string;
  /** Quando informado, emite <meta name="robots">. */
  robots?: string;
}

const {
  title = 'Petisquinho',
  description = 'Uma porção de curiosidade por dia, sem compromisso.',
  ogImage = siteConfig.defaultOgImage,
  ogType = 'website',
  robots
} = Astro.props;

// Barra final em todos os links internos de propósito: o Astro publica em
// formato de diretório, então /categoria/x sem barra responde 301 antes de
// chegar na página. O menu e o rodapé aparecem em todas as páginas, então o
// custo desse detalhe se multiplicava por 37.
const navItems = [
  { label: 'Início', href: '/' },
  ...siteConfig.categories.map((category) => ({
    label: category.label,
    href: `/categoria/${category.slug}/`
  }))
];

const siteUrl = Astro.site ?? siteConfig.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL(ogImage, siteUrl).toString();
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#C8553D" />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(siteConfig.ogImageWidth)} />
    <meta property="og:image:height" content={String(siteConfig.ogImageHeight)} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- Conteúdo específico da página: dados estruturados, meta de artigo. -->
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- Skip link: fica invisível até receber foco pelo teclado. Sem ele, um
         usuário de teclado atravessa o menu inteiro em toda página antes de
         chegar ao conteúdo. -->
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-marine focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg">Pular para o conteúdo</a>
    <header class="sticky top-0 z-20 border-b border-slate-200/80 bg-cream/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
        <a href="/" class="inline-flex items-center gap-3 text-2xl font-black uppercase tracking-tight text-[#A8432F]">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-terracotta text-sm text-white shadow-sm">P</span>
          <span>petisquinho</span>
        </a>
        <nav class="flex flex-wrap items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-marine/80 md:text-[11px]">
          {navItems.map((item) => (
            <a href={item.href} class="rounded-full border border-slate-200 bg-white/70 px-3 py-2 transition hover:border-terracotta hover:bg-white hover:text-[#A8432F]">{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="conteudo" class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6 lg:px-8">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-marine text-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-8 sm:px-6 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <!-- Mostarda, não terracotta: o rodapé tem fundo azul-marinho escuro,
               e ali o tom claro é que contrasta. Terracotta cheio dá 3,27:1
               (serve só para texto grande e no limite) e o tom escuro que uso
               no resto do site cai para 2,38:1. Mostarda dá 7,53:1 e já era a
               cor dos links do rodapé no hover. -->
          <p class="text-xl font-black uppercase tracking-tight text-mustard">petisquinho</p>
          <p class="mt-2 text-sm text-slate-300">Uma porção de curiosidade por dia, sem compromisso.</p>
        </div>

        <!-- As seções entraram no rodapé para dar mais uma superfície de link
             interno em todas as páginas, sem custo para quem escreve. O menu do
             topo já as lista, mas o rodapé alcança quem rolou até o fim.
             Dois <nav> com aria-label porque são grupos de navegação distintos
             e o leitor de tela precisa poder distingui-los. -->
        <div class="flex flex-col gap-6 sm:flex-row sm:gap-10">
          <nav aria-label="Seções">
            <h2 class="text-[11px] font-bold uppercase tracking-[0.16em] text-slate-400">Seções</h2>
            <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm text-slate-200">
              {siteConfig.categories.map((categoria) => (
                <li>
                  <a href={`/categoria/${categoria.slug}/`} class="transition hover:text-mustard">{categoria.label}</a>
                </li>
              ))}
            </ul>
          </nav>

          <nav aria-label="Institucional">
            <h2 class="text-[11px] font-bold uppercase tracking-[0.16em] text-slate-400">Institucional</h2>
            <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm text-slate-200">
              <li><a href="/sobre/" class="transition hover:text-mustard">Sobre</a></li>
              <li><a href="/contato/" class="transition hover:text-mustard">Contato</a></li>
              <li><a href="/privacidade/" class="transition hover:text-mustard">Privacidade</a></li>
              <li><a href="/termos-de-uso/" class="transition hover:text-mustard">Termos de Uso</a></li>
              <li><a href="/rss.xml" class="transition hover:text-mustard">RSS</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>
