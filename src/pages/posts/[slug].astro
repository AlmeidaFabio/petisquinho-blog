---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { PostSource } from '../../content/config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import { srcsetDe, SIZES } from '../../utils/images';

export async function getStaticPaths() {
  const posts: CollectionEntry<'posts'>[] = await getCollection('posts');
  return posts
    .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
    .map((post: CollectionEntry<'posts'>) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const posts: CollectionEntry<'posts'>[] = await getCollection('posts');
const post = posts.find((entry: CollectionEntry<'posts'>) => entry.slug === slug);

if (!post) {
  throw new Error(`Post não encontrado: ${slug}`);
}

const siteUrl = Astro.site ?? siteConfig.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

// Card 1200x630 em JPG, gerado por scripts/generate-og-images.mjs no build.
// É JPG de propósito: a capa em si é WebP e alguns rastreadores de
// pré-visualização ainda não exibem WebP.
const ogImagePath = `/og/${slug}.jpg`;
const socialImageUrl = new URL(ogImagePath, siteUrl).toString();

// Texto de compartilhamento. Usa canonicalUrl em vez de montar a URL na mão:
// Astro.site.toString() termina em "/", e concatenar com Astro.url.pathname
// (que também começa com "/") gerava https://petisquinho.com//posts/...
const shareText = `${post.data.title} — ${canonicalUrl}`;

const sameCategoryPosts = posts.filter(
  (entry: CollectionEntry<'posts'>) =>
    entry.slug !== post.slug &&
    !entry.data.draft &&
    entry.data.category === post.data.category
);

for (let index = sameCategoryPosts.length - 1; index > 0; index -= 1) {
  const randomIndex = Math.floor(Math.random() * (index + 1));
  [sameCategoryPosts[index], sameCategoryPosts[randomIndex]] = [
    sameCategoryPosts[randomIndex],
    sameCategoryPosts[index]
  ];
}

const categoryRecommendations = sameCategoryPosts.slice(0, 2);
const relatedPosts = posts.filter(
  (entry: CollectionEntry<'posts'>) => !entry.data.draft && entry.slug !== post.slug
);

for (let index = relatedPosts.length - 1; index > 0; index -= 1) {
  const randomIndex = Math.floor(Math.random() * (index + 1));
  [relatedPosts[index], relatedPosts[randomIndex]] = [
    relatedPosts[randomIndex],
    relatedPosts[index]
  ];
}

relatedPosts.length = Math.min(relatedPosts.length, 3);

const { Content } = await post.render();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  image: socialImageUrl,
  datePublished: new Date(post.data.date).toISOString(),
  inLanguage: 'pt-BR',
  articleSection: post.data.section,
  author: {
    '@type': 'Person',
    name: siteConfig.author.name,
    url: new URL(siteConfig.author.url, siteUrl).toString()
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    logo: {
      '@type': 'ImageObject',
      url: 'https://petisquinho.com/favicon.png'
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl
  }
};
---

<BaseLayout
  title={`${post.data.title} - Petisquinho`}
  description={post.data.excerpt}
  ogImage={ogImagePath}
  ogType="article"
>
  <Fragment slot="head">
    <!-- A capa é o elemento de LCP desta página: antecipa o download e faz o
         navegador escolher a mesma variante que o srcset usaria. -->
    {post.data.image && (
      <link
        rel="preload"
        as="image"
        href={post.data.image}
        imagesrcset={srcsetDe(post.data.image) ?? undefined}
        imagesizes={SIZES.capaDoPost}
        fetchpriority="high"
      />
    )}
    <meta property="article:published_time" content={new Date(post.data.date).toISOString()} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_260px]">
    <article class="overflow-hidden rounded-[32px] border border-slate-200 bg-white/85 shadow-soft">
      {post.data.image && <img src={post.data.image} srcset={srcsetDe(post.data.image) ?? undefined} sizes={SIZES.capaDoPost} alt={post.data.imageAlt ?? post.data.title} class="aspect-[16/8] w-full object-cover" loading="eager" fetchpriority="high" />}
      <div class="border-b border-slate-200 bg-gradient-to-r from-cream via-white to-slate-50 px-4 pb-7 pt-6 sm:px-6 lg:px-8">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
          <a href={`/categoria/${post.data.category}/`} class="inline-flex rounded-full border border-terracotta/20 bg-terracotta/5 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#A8432F] transition hover:border-terracotta/40">{post.data.section}</a>
          <div class="flex flex-wrap items-center gap-2 text-xs text-slate-600">
            <span class="rounded-full bg-slate-100 px-2.5 py-1">{new Date(post.data.date).toLocaleDateString('pt-BR')}</span>
            <span class="rounded-full bg-terracotta/10 px-2.5 py-1 font-semibold text-[#A8432F]">{post.data.readingTime}</span>
          </div>
        </div>

        <h1 class="article-title max-w-3xl text-4xl font-black leading-[1.05] text-marine sm:text-5xl lg:text-[3.25rem]">{post.data.title}</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">{post.data.excerpt}</p>
        <p class="mt-5 text-sm text-slate-600">
          Por <a href={siteConfig.author.url} class="font-semibold text-marine underline decoration-slate-300 underline-offset-4 transition hover:text-[#A8432F]">{siteConfig.author.name}</a><span class="mx-1.5" aria-hidden="true">·</span>{siteConfig.author.role}
        </p>
      </div>

      <div class="px-4 py-6 sm:px-6 lg:px-8">
        {siteConfig.adsEnabled && (
          <div class="mb-8 flex justify-center">
            <div class="ad-slot h-24 w-full max-w-5xl">Publicidade</div>
          </div>
        )}

        <div class="article-content prose prose-lg max-w-3xl">
          <Content />
        </div>

        {siteConfig.adsEnabled && (
          <div class="mt-10 flex justify-center">
            <div class="ad-slot h-24 w-full max-w-5xl">Publicidade</div>
          </div>
        )}

        {post.data.sources.length > 0 && (
          <section class="mt-12 rounded-[24px] border border-slate-200 bg-slate-50 p-5 sm:p-6">
            <h2 class="text-2xl font-black text-marine">Fontes</h2>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-700">
              {post.data.sources.map((source: PostSource) => (
                <li><a href={source.url} target="_blank" rel="noopener noreferrer" class="underline decoration-slate-300 underline-offset-4 hover:text-[#A8432F]">{source.label}</a></li>
              ))}
            </ul>
          </section>
        )}

        <section class="mt-10">
          <div class="mb-5 flex items-center justify-between gap-3">
            <h2 class="text-2xl font-black text-marine">Leia também</h2>
            <a href="/busca/" class="text-sm font-semibold text-marine underline decoration-slate-300 underline-offset-4 transition hover:text-[#A8432F]">Ver tudo →</a>
          </div>

          <div class="grid gap-4 md:grid-cols-3">
            {relatedPosts.map((related: CollectionEntry<'posts'>) => (
              <article class="overflow-hidden rounded-[22px] border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:border-terracotta/30 hover:shadow-soft">
                {related.data.image && <img src={related.data.image} srcset={srcsetDe(related.data.image) ?? undefined} sizes={SIZES.cardTresColunas} alt={related.data.imageAlt ?? related.data.title} class="aspect-[16/9] w-full object-cover" loading="lazy" decoding="async" />}
                <div class="p-4">
                  <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#A8432F]">{related.data.section}</p>
                  <a href={`/posts/${related.slug}/`} class="mt-3 block text-lg font-black leading-snug text-marine hover:text-[#A8432F]">
                    {related.data.title}
                  </a>
                  <p class="mt-3 text-sm leading-6 text-slate-600">{related.data.excerpt}</p>
                  <div class="mt-4 flex items-center gap-2 text-[11px] text-slate-500">
                    <span>{new Date(related.data.date).toLocaleDateString('pt-BR')}</span>
                    <span>•</span>
                    <span>{related.data.readingTime}</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="mt-8 rounded-[24px] border border-slate-200/80 bg-cream/60 p-4 sm:p-5">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-sm font-bold uppercase tracking-[0.14em] text-marine">Compartilhe</p>
              <p class="mt-1 text-xs text-slate-500">Envie esta leitura para alguém.</p>
            </div>
            <div class="flex flex-wrap gap-3">
              <a href={`https://wa.me/?text=${encodeURIComponent(shareText)}`} target="_blank" rel="noopener" class="inline-flex h-11 items-center gap-2 rounded-full border border-emerald-700/15 bg-emerald-700 px-4 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-emerald-800 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-800 focus-visible:ring-offset-2" aria-label="Compartilhar no WhatsApp">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4 fill-current">
                  <path d="M12.04 2C6.59 2 2.17 6.29 2.17 11.63c0 2.04.63 4.03 1.72 5.7L2 22l4.89-1.53a9.66 9.66 0 0 0 5.15 1.59h.01c5.45 0 9.87-4.29 9.87-9.63S17.49 2 12.04 2Zm5.56 13.65c-.22.62-1.29 1.16-1.78 1.23-.47.07-1.06.1-3.42-.72-2.9-1.04-4.78-3.64-4.93-3.83-.15-.19-1.22-1.62-1.22-3.09 0-1.47.77-2.2 1.03-2.5.27-.31.58-.38.78-.38h.56c.18 0 .42.01.64.49.29.62.98 2.17 1.06 2.33.08.16.13.35.02.56-.11.2-.17.33-.34.51-.17.18-.36.4-.52.55-.17.17-.35.35-.15.69.2.34.9 1.48 1.94 2.39 1.33 1.18 2.45 1.55 2.8 1.73.35.18.56.15.76-.09.2-.24.86-1 1.09-1.34.23-.34.46-.28.78-.17.32.11 2.05 1.03 2.41 1.21.36.18.6.27.69.42.09.16.09.93-.13 1.55Z"/>
                </svg>
                <span>WhatsApp</span>
              </a>
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}`} target="_blank" rel="noopener" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-300/80 bg-white text-marine shadow-sm transition hover:-translate-y-0.5 hover:border-marine/30 hover:bg-slate-50 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-marine focus-visible:ring-offset-2" aria-label="Compartilhar no X" title="Compartilhar no X">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4 fill-current">
                  <path d="M18.9 2h3.6l-7.87 9.01L22.7 22h-7.11l-5.55-7.82L3.18 22H-0.4l8.43-9.66L0.5 2h7.28l5.02 7.05L18.9 2Zm-1.26 18.1h1.97L7.12 3.8H5.09l12.55 16.3Z"/>
                </svg>
              </a>
              <button id="copy-link" class="inline-flex h-11 items-center gap-2 rounded-full border border-marine/10 bg-marine px-4 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-[#26375d] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-marine focus-visible:ring-offset-2" aria-label="Copiar link da matéria">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4 fill-none stroke-current stroke-[2]">
                  <path d="M10 13a5 5 0 0 1 0-7l1.25-1.25a5 5 0 1 1 7.07 7.07L16.5 12.5"/>
                  <path d="M14 11a5 5 0 0 1 0 7l-1.25 1.25a5 5 0 1 1-7.07-7.07L7.5 11.5"/>
                </svg>
                <span id="copy-link-label">Copiar link</span>
              </button>
            </div>
          </div>
        </section>
      </div>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-28 space-y-5">
        {categoryRecommendations.length > 0 && (
          <section aria-labelledby="category-recommendations-title" class="space-y-4">
            <div class="mb-1 flex items-center gap-3">
              <span aria-hidden="true" class="h-5 w-1 rounded-full bg-terracotta"></span>
              <h2 id="category-recommendations-title" class="text-sm font-black leading-none text-marine">Na mesma linha</h2>
            </div>
            {categoryRecommendations.map((recommendation: CollectionEntry<'posts'>) => (
              <article class="overflow-hidden rounded-[24px] border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:border-terracotta/30 hover:shadow-soft">
                <a href={`/posts/${recommendation.slug}/`} class="block">
                  {recommendation.data.image && (
                    <img
                      src={recommendation.data.image}
                      srcset={srcsetDe(recommendation.data.image) ?? undefined}
                      sizes={SIZES.cardDaColunaLateral}
                      alt={recommendation.data.imageAlt ?? recommendation.data.title}
                      class="aspect-[16/9] w-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="px-4 py-3.5">
                    <h3 class="text-base font-black leading-snug text-marine transition-colors hover:text-[#A8432F]">{recommendation.data.title}</h3>
                  </div>
                </a>
              </article>
            ))}
          </section>
        )}
        {siteConfig.adsEnabled && <div class="ad-slot sticky top-28 h-[520px]">Publicidade</div>}
      </div>
    </aside>
  </div>

  <script>
    document.getElementById('copy-link')?.addEventListener('click', async () => {
      const label = document.getElementById('copy-link-label');
      if (!label) return;

      try {
        await navigator.clipboard.writeText(window.location.href);
        label.textContent = 'Link copiado';
      } catch {
        label.textContent = 'Não foi possível copiar';
      }

      setTimeout(() => {
        label.textContent = 'Copiar link';
      }, 2000);
    });
  </script>
</BaseLayout>
