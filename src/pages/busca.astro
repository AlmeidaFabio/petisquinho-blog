---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts: CollectionEntry<'posts'>[] = await getCollection('posts');
const posts = allPosts
  .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .map((post: CollectionEntry<'posts'>) => ({
    title: post.data.title,
    excerpt: post.data.excerpt,
    href: `/posts/${post.slug}`,
    section: post.data.section,
    image: post.data.image,
    imageAlt: post.data.imageAlt ?? post.data.title,
    tags: post.data.tags.join(', '),
    date: new Date(post.data.date).toLocaleDateString('pt-BR'),
    readingTime: post.data.readingTime
  }));
---

<BaseLayout title="Buscar - Petisquinho" description="Busque por curiosidades e textos do blog Petisquinho.">
  <section class="mx-auto max-w-6xl">
    <header class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-terracotta">Arquivo Petisquinho</p>
      <h1 class="mt-3 font-serif text-4xl font-black leading-tight text-marine sm:text-5xl">Uma curiosidade leva a outra.</h1>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-slate-600 sm:text-base">
        Explore textos sobre cultura, ideias e pequenas curiosidades do dia a dia.
      </p>
    </header>

    <div class="mx-auto mt-7 max-w-3xl rounded-[24px] border border-slate-200 bg-white p-3 shadow-soft sm:p-4">
      <label class="search-field flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 transition focus-within:border-terracotta/50 focus-within:ring-2 focus-within:ring-terracotta/10">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 shrink-0 fill-none stroke-slate-400 stroke-[2]">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-4-4" />
          </svg>
          <span class="sr-only">Buscar artigos</span>
          <input
            id="search-input"
            type="search"
            placeholder="Busque um tema, uma palavra ou uma ideia..."
            class="search-field-input min-w-0 flex-1 bg-transparent text-sm text-marine outline-none placeholder:text-slate-400 sm:text-base"
            autocomplete="off"
          />
      </label>

      <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-xs sm:justify-start">
        <span class="mr-1 font-semibold text-slate-500">Sugestões:</span>
        <button type="button" data-search-term="cultura" class="search-suggestion rounded-full border border-slate-200 bg-white px-3 py-1.5 text-slate-600 transition hover:border-terracotta/40 hover:text-terracotta">cultura</button>
        <button type="button" data-search-term="curiosidade" class="search-suggestion rounded-full border border-slate-200 bg-white px-3 py-1.5 text-slate-600 transition hover:border-terracotta/40 hover:text-terracotta">curiosidades</button>
        <button type="button" data-search-term="café" class="search-suggestion rounded-full border border-slate-200 bg-white px-3 py-1.5 text-slate-600 transition hover:border-terracotta/40 hover:text-terracotta">café</button>
      </div>
    </div>

    <section class="mt-10" aria-labelledby="results-heading">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-3 border-b border-slate-200 pb-4">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-terracotta">Da nossa redação</p>
          <h2 id="results-heading" class="mt-1 text-2xl font-black text-marine">Explore os artigos</h2>
        </div>
        <p id="results-count" class="results-count rounded-full bg-white text-xs font-semibold text-slate-500" aria-live="polite"></p>
      </div>
      <div id="search-results" class="grid gap-4 md:grid-cols-2"></div>
    </section>
  </section>

  <script type="application/json" id="posts-data" set:html={JSON.stringify(posts)}></script>
  <script>
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const results = document.getElementById('search-results');
    const count = document.getElementById('results-count');
    const data = JSON.parse(document.getElementById('posts-data')?.textContent ?? '[]');

    function normalize(value: string) {
      return value
        .toLocaleLowerCase('pt-BR')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
    }

    function addTextElement(parent: HTMLElement, tag: string, text: string, className: string) {
      const element = document.createElement(tag);
      element.className = className;
      element.textContent = text;
      parent.append(element);
      return element;
    }

    function renderResults(items: typeof data) {
      if (!results || !count) return;

      results.replaceChildren();
      count.textContent = `${items.length} ${items.length === 1 ? 'artigo' : 'artigos'}`;

      if (!items.length) {
        const empty = document.createElement('div');
        empty.className = 'col-span-full rounded-[24px] border border-slate-200 bg-white px-6 py-10 text-center shadow-sm';
        addTextElement(empty, 'p', 'Nenhum artigo encontrado', 'text-lg font-black text-marine');
        addTextElement(empty, 'p', 'Tente outra palavra ou explore uma das sugestões acima.', 'mt-2 text-sm text-slate-500');
        results.append(empty);
        return;
      }

      for (const post of items) {
        const card = document.createElement('article');
        card.className = 'group overflow-hidden rounded-[24px] border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:border-terracotta/30 hover:shadow-soft';

        const link = document.createElement('a');
        link.href = post.href;
        link.className = 'block h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-terracotta';
        link.setAttribute('aria-label', `${post.title} — ${post.section}`);

        if (post.image) {
          const image = document.createElement('img');
          image.src = post.image;
          image.alt = post.imageAlt;
          image.loading = 'lazy';
          image.decoding = 'async';
          image.className = 'aspect-[16/9] w-full object-cover';
          link.append(image);
        }

        const content = document.createElement('div');
        content.className = 'p-5 sm:p-6';
        addTextElement(content, 'p', post.section, 'text-[10px] font-bold uppercase tracking-[0.17em] text-terracotta');
        addTextElement(content, 'h3', post.title, 'mt-3 text-xl font-black leading-snug text-marine transition group-hover:text-terracotta');
        addTextElement(content, 'p', post.excerpt, 'mt-3 text-sm leading-7 text-slate-600');

        const footer = document.createElement('div');
        footer.className = 'mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4';
        addTextElement(footer, 'span', post.date, 'text-xs text-slate-500');
        addTextElement(footer, 'span', post.readingTime, 'rounded-full bg-terracotta/10 px-3 py-1 text-xs font-semibold text-terracotta');
        content.append(footer);

        if (post.tags) {
          addTextElement(content, 'p', post.tags, 'mt-3 line-clamp-1 text-[11px] text-slate-400');
        }

        link.append(content);
        card.append(link);
        results.append(card);
      }
    }

    function searchPosts(term: string) {
      const normalized = normalize(term);
      const nextItems = !normalized
        ? data
        : data.filter((post: (typeof data)[number]) => {
            const haystack = normalize(`${post.title} ${post.excerpt} ${post.section} ${post.tags}`);
            return haystack.includes(normalized);
          });
      renderResults(nextItems);
    }

    input?.addEventListener('input', () => searchPosts(input.value));

    document.querySelectorAll<HTMLButtonElement>('.search-suggestion').forEach((button) => {
      button.addEventListener('click', () => {
        if (!input) return;
        input.value = button.dataset.searchTerm ?? '';
        searchPosts(input.value);
        input.focus();
      });
    });

    // Aceita ?q=termo para a busca poder ser acionada de fora. É o que faz o
    // formulário de busca da página 404 funcionar.
    const termoInicial = new URLSearchParams(window.location.search).get('q') ?? '';
    if (input && termoInicial) input.value = termoInicial;
    searchPosts(termoInicial);
  </script>
</BaseLayout>
