---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListaDaCategoria from '../../components/ListaDaCategoria.astro';
import { siteConfig } from '../../config/site';
import { srcsetDe, SIZES } from '../../utils/images';
import {
  paginarDaCategoria,
  postsDaCategoria,
  postsPublicados,
  urlDaPagina,
  type PaginaDeCategoria
} from '../../utils/categorias';

/**
 * Primeira página de cada categoria (RF3 do PRD).
 *
 * As páginas 2 em diante ficam em categoria/[slug]/pagina/[pagina].astro. A
 * primeira mora na raiz da categoria de propósito, para não existirem duas URLs
 * para o mesmo conteúdo nem um redirecionamento extra em cada visita.
 */
export async function getStaticPaths() {
  const posts = await postsPublicados();

  return siteConfig.categories.map((categoria) => {
    const [primeira] = paginarDaCategoria(postsDaCategoria(posts, categoria.slug), categoria);
    return { params: { slug: categoria.slug }, props: { listagem: primeira } };
  });
}

const { listagem } = Astro.props as { listagem: PaginaDeCategoria };
const { categoria, posts, totalPaginas } = listagem;

const capa = posts[0]?.data.image;
---

<BaseLayout
  title={`${categoria.label} - Petisquinho`}
  description={`Artigos da categoria ${categoria.label} no blog Petisquinho.`}
>
  <Fragment slot="head">
    {/* A capa do primeiro card é o elemento de LCP desta página. Ela estava
         com loading="lazy", o que atrasava justamente a imagem que define a
         métrica: o Speed Index variava de 1,0 s a 9,1 s conforme o momento em
         que ela entrava. */}
    {capa && (
      <link
        rel="preload"
        as="image"
        href={capa}
        imagesrcset={srcsetDe(capa) ?? undefined}
        imagesizes={SIZES.cardDuasColunas}
        fetchpriority="high"
      />
    )}
    {totalPaginas > 1 && <link rel="next" href={urlDaPagina(categoria.slug, 2)} />}
  </Fragment>

  <ListaDaCategoria listagem={listagem} />
</BaseLayout>
