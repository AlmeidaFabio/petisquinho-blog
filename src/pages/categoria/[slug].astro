---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return [
    { params: { slug: 'curiosidades-de-boteco' } },
    { params: { slug: 'petisco-cultural' } },
    { params: { slug: 'mix-de-variedades' } },
    { params: { slug: 'a-saideira' } }
  ];
}

const { slug } = Astro.params;
const allPosts: CollectionEntry<'posts'>[] = await getCollection('posts');
const posts = allPosts
  .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
  .filter((post: CollectionEntry<'posts'>) => post.data.category === slug)
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// O slug técnico é diferente do nome visível de propósito: "curiosidades" é o
// termo de busca real da categoria, então o endereço /categoria/curiosidades-de-boteco
// permanece mesmo que o rótulo mude. Ver docs/direcao-editorial.md.
const labels: Record<string, string> = {
  'curiosidades-de-boteco': 'Papo de Boteco',
  'petisco-cultural': 'Petisco Cultural',
  'mix-de-variedades': 'Mix de Variedades',
  'a-saideira': 'A Saideira'
};

const title = labels[slug] ?? 'Categoria';
---

<BaseLayout title={`${title} - Petisquinho`} description={`Artigos da categoria ${title} no blog Petisquinho.`}>
  <section>
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.15em] text-terracotta">Categoria</p>
    <h1 class="text-4xl font-black text-marine">{title}</h1>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {posts.map((post: CollectionEntry<'posts'>) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} class="mb-5 aspect-[16/9] w-full rounded-2xl object-cover" loading="lazy" decoding="async" />
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-terracotta">{post.data.section}</p>
          <a href={`/posts/${post.slug}`} class="mt-3 block text-2xl font-black text-marine hover:text-terracotta">{post.data.title}</a>
          <p class="mt-4 text-sm leading-7 text-slate-600">{post.data.excerpt}</p>
          <div class="mt-4 flex items-center gap-3 text-xs text-slate-500">
            <span>{new Date(post.data.date).toLocaleDateString('pt-BR')}</span>
            <span>•</span>
            <span>{post.data.readingTime}</span>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
