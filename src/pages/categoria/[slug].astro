---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import { srcsetDe, SIZES } from '../../utils/images';

export async function getStaticPaths() {
  return siteConfig.categories.map((category) => ({ params: { slug: category.slug } }));
}

const { slug } = Astro.params;
const allPosts: CollectionEntry<'posts'>[] = await getCollection('posts');
const posts = allPosts
  .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
  .filter((post: CollectionEntry<'posts'>) => post.data.category === slug)
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// O rótulo visível e o endereço vivem em siteConfig.categories, que é a fonte
// única. O slug técnico é diferente do nome exibido de propósito; a explicação
// está no próprio arquivo de configuração.
const title = siteConfig.categories.find((category) => category.slug === slug)?.label ?? 'Categoria';
---

<BaseLayout title={`${title} - Petisquinho`} description={`Artigos da categoria ${title} no blog Petisquinho.`}>
  <Fragment slot="head">
    <!-- A capa do primeiro card é o elemento de LCP desta página. Ela estava
         com loading="lazy", o que atrasava justamente a imagem que define a
         métrica: o Speed Index variava de 1,0 s a 9,1 s conforme o momento em
         que ela entrava. -->
    {posts[0]?.data.image && (
      <link
        rel="preload"
        as="image"
        href={posts[0].data.image}
        imagesrcset={srcsetDe(posts[0].data.image) ?? undefined}
        imagesizes={SIZES.cardDuasColunas}
        fetchpriority="high"
      />
    )}
  </Fragment>

  <section>
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.15em] text-terracotta-dark">Categoria</p>
    <h1 class="text-4xl font-black text-marine">{title}</h1>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {posts.map((post: CollectionEntry<'posts'>, index: number) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <img src={post.data.image} srcset={srcsetDe(post.data.image) ?? undefined} sizes={SIZES.cardDuasColunas} alt={post.data.imageAlt ?? post.data.title} class="mb-5 aspect-[16/9] w-full rounded-2xl object-cover" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} decoding="async" />
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-terracotta-dark">{post.data.section}</p>
          <a href={`/posts/${post.slug}/`} class="mt-3 block text-2xl font-black text-marine hover:text-terracotta-dark">{post.data.title}</a>
          <p class="mt-4 text-sm leading-7 text-slate-600">{post.data.excerpt}</p>
          <div class="mt-4 flex items-center gap-3 text-xs text-slate-500">
            <span>{new Date(post.data.date).toLocaleDateString('pt-BR')}</span>
            <span>•</span>
            <span>{post.data.readingTime}</span>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
