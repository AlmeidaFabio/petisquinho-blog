---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const allPosts: CollectionEntry<'posts'>[] = await getCollection('posts');
const recentPosts = allPosts
  .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
  .sort(
    (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) =>
      new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
  )
  .slice(0, 6);
---

<BaseLayout
  title="Página não encontrada - Petisquinho"
  description="O endereço que você tentou abrir não existe. Use a busca ou explore as seções e as matérias mais recentes do blog."
  robots="noindex, follow"
>
  <section class="mx-auto max-w-3xl text-center">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-terracotta-dark">Erro 404</p>
    <h1 class="mt-3 font-serif text-4xl font-black leading-tight text-marine sm:text-5xl">Essa página saiu do cardápio.</h1>
    <p class="mx-auto mt-4 max-w-xl text-base leading-7 text-slate-600">
      O endereço que você abriu não existe. Pode ter sido digitado errado, ou a matéria mudou de lugar. Daqui dá
      para buscar o que você procurava ou ir direto para uma das seções.
    </p>

    <form action="/busca/" method="get" role="search" class="mx-auto mt-7 max-w-2xl rounded-[24px] border border-slate-200 bg-white p-3 text-left shadow-soft sm:p-4">
      <label for="busca-404" class="flex flex-wrap items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 transition focus-within:border-terracotta focus-within:ring-2 focus-within:ring-terracotta">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 shrink-0 fill-none stroke-slate-500 stroke-[2]">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-4-4" />
        </svg>
        <span class="sr-only">Buscar no blog</span>
        <input
          id="busca-404"
          name="q"
          type="search"
          placeholder="Busque um tema, uma palavra ou uma ideia..."
          class="min-w-0 flex-1 bg-transparent py-3 text-sm text-marine outline-none placeholder:text-slate-500 sm:text-base"
          autocomplete="off"
        />
        <button type="submit" class="shrink-0 rounded-full bg-marine px-4 py-2 text-sm font-bold text-white transition hover:bg-[#2b3a5b] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta focus-visible:ring-offset-2">Buscar</button>
      </label>
    </form>

    <a href="/" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-marine underline decoration-slate-300 underline-offset-4 transition hover:text-terracotta-dark">
      Voltar para a página inicial
    </a>
  </section>

  <section class="mt-14" aria-labelledby="secoes-404">
    <h2 id="secoes-404" class="text-2xl font-black text-marine">Explore por seção</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {siteConfig.categories.map((category) => (
        <a href={`/categoria/${category.slug}/`} class="group flex items-center justify-between gap-4 rounded-[22px] border border-slate-200 bg-white px-5 py-4 shadow-sm transition hover:-translate-y-0.5 hover:border-terracotta/30 hover:shadow-soft">
          <span class="font-bold text-marine transition group-hover:text-terracotta-dark">{category.label}</span>
          <span aria-hidden="true" class="font-bold text-terracotta-dark">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-14" aria-labelledby="recentes-404">
    <div class="mb-6 flex items-center justify-between gap-3">
      <h2 id="recentes-404" class="text-2xl font-black text-marine">Matérias recentes</h2>
      <a href="/busca/" class="text-sm font-semibold text-marine underline decoration-slate-300 underline-offset-4 transition hover:text-terracotta-dark">Ver todas →</a>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {recentPosts.map((post: CollectionEntry<'posts'>) => (
        <article class="overflow-hidden rounded-[24px] border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:border-terracotta/30 hover:shadow-soft">
          <img
            src={post.data.image}
            alt={post.data.imageAlt ?? post.data.title}
            class="aspect-[16/9] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <div class="p-5">
            <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-terracotta-dark">{post.data.section}</p>
            <a href={`/posts/${post.slug}/`} class="mt-3 block text-xl font-black leading-snug text-marine transition hover:text-terracotta-dark">{post.data.title}</a>
            <p class="mt-3 text-sm leading-6 text-slate-600">{post.data.excerpt}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
