---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { srcsetDe, SIZES } from '../utils/images';
import { dataLegivel, tempoDeLeitura } from '../utils/posts';
import { schemaOrganizacao, schemaWebSite } from '../utils/schema';

const siteUrl = Astro.site ?? siteConfig.url;

const allPosts: CollectionEntry<'posts'>[] = await getCollection('posts');
const posts = allPosts
  .filter((post: CollectionEntry<'posts'>) => !post.data.draft)
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// O carrossel passa a usar `featured`, que existia no schema desde o início e
// não era lido por nenhum template — o post marcado como destaque não recebia
// destaque nenhum.
//
// Antes o critério era "posts caídos na semana do build": a mesma home assumia
// formas diferentes conforme o dia em que o build rodasse, e numa semana sem
// posts o carrossel virava a lista de recentes. Agora depende só do conteúdo,
// que é o que torna o resultado estável e reproduzível.
//
// Destaques primeiro, completando com os mais recentes para o carrossel não
// encolher quando houver só um post marcado.
const destaques = posts.filter((post: CollectionEntry<'posts'>) => post.data.featured);
const recentes = posts.filter((post: CollectionEntry<'posts'>) => !post.data.featured);
const carouselPosts = (destaques.length > 0 ? [...destaques, ...recentes] : posts).slice(0, 5);
const carouselPostSlugs = new Set(carouselPosts.map((post: CollectionEntry<'posts'>) => post.slug));
const recentPosts = posts
  .filter((post: CollectionEntry<'posts'>) => !carouselPostSlugs.has(post.slug))
  .slice(0, 6);
---

<BaseLayout title="Petisquinho - Uma porção de curiosidade pro seu dia" description="Blog brasileiro sobre cultura, curiosidades e variedades.">
  <Fragment slot="head">
    <!-- O primeiro slide do carrossel é o elemento de LCP desta página. O
         preload antecipa o download para antes de o HTML terminar de ser
         processado, e o imagesrcset garante que o navegador baixe a variante
         que vai usar de fato, não a maior. -->
    {carouselPosts[0]?.data.image && (
      <link
        rel="preload"
        as="image"
        href={carouselPosts[0].data.image}
        imagesrcset={srcsetDe(carouselPosts[0].data.image) ?? undefined}
        imagesizes={SIZES.capaDoCarrossel}
        fetchpriority="high"
      />
    )}
    <!-- WebSite com SearchAction habilita a caixa de pesquisa do site direto
         no resultado do Google; Organization liga a marca a uma entidade. A
         home não tinha nenhum JSON-LD. -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaWebSite(siteUrl))} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrganizacao(siteUrl))} />
  </Fragment>

  <section class="mb-12 grid gap-8 lg:grid-cols-[1.5fr_0.8fr]">
    {/* Sem altura fixa. Antes o container tinha h-[600px] (640 a partir de sm) e
        o conteúdo do slide ocupava cerca de 410 px, então sobrava um vazio de
        uns 190 px entre o resumo e as bolinhas. O bloco ao lado herdava o mesmo
        vazio, porque esticava para acompanhar a linha da grade.

        Agora os slides ficam empilhados na MESMA célula da grade: a altura vem
        do slide mais alto e não muda ao trocar de slide, então não há salto de
        layout. Os inativos usam visibility em vez do atributo hidden — assim
        continuam ocupando espaço para dimensionar a célula, e saem da árvore de
        acessibilidade e do foco do mesmo jeito. */}
    <div data-post-carousel role="region" aria-roledescription="carrossel" aria-label={destaques.length > 0 ? 'Destaques e posts recentes' : 'Posts recentes'} class="relative grid overflow-hidden rounded-[30px] border border-terracotta/10 bg-white shadow-soft">
      {carouselPosts.map((post: CollectionEntry<'posts'>, index: number) => (
        <article
          data-carousel-slide
          aria-roledescription="slide"
          aria-label={`Post ${index + 1} de ${carouselPosts.length}`}
          class:list={[
            'col-start-1 row-start-1 flex flex-col transition-opacity duration-300',
            index === 0 ? 'opacity-100' : 'pointer-events-none invisible opacity-0'
          ]}
        >
          <div class="relative h-56 shrink-0 sm:h-72">
            {/* Só o primeiro slide carrega a imagem de imediato. Os outros
                guardam o endereço em data-src, e o JavaScript materializa
                quando o slide entra.
                Motivo: os slides inativos usam visibility para manter a altura
                do carrossel estável, e com isso o navegador considera as cinco
                imagens dentro da tela e baixa todas de uma vez. Medido: a home
                ia de 278 KB para 431 KB. */}
            {index === 0 ? (
              <img src={post.data.image} srcset={srcsetDe(post.data.image) ?? undefined} sizes={SIZES.capaDoCarrossel} alt={post.data.imageAlt ?? post.data.title} class="h-full w-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
            ) : (
              <img data-src={post.data.image} data-srcset={srcsetDe(post.data.image) ?? undefined} sizes={SIZES.capaDoCarrossel} alt={post.data.imageAlt ?? post.data.title} class="h-full w-full object-cover" decoding="async" />
            )}
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-marine/75 to-transparent p-5 pt-14 text-white sm:p-6 sm:pt-16">
              <span class="inline-flex rounded-full border border-white/50 bg-marine/25 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] backdrop-blur-sm">
                {/* O selo diz o que o slide é de fato. Antes era fixo em
                    "Destaques da semana", que deixou de ser verdade quando o
                    critério passou de "semana do build" para `featured`. */}
                {post.data.featured ? 'Destaque' : 'Recente'}
              </span>
            </div>
            {carouselPosts.length > 1 && (
              <div class="absolute inset-x-0 top-1/2 z-10 flex -translate-y-1/2 justify-between px-4 sm:px-5">
                <button type="button" data-carousel-prev aria-label="Post anterior" class="group flex h-11 w-11 items-center justify-center rounded-full border border-white/70 bg-white/85 text-marine shadow-lg backdrop-blur-md transition duration-200 hover:scale-105 hover:border-white hover:bg-white hover:text-[#A8432F] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta focus-visible:ring-offset-2 focus-visible:ring-offset-white/50 active:scale-95">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 transition-transform duration-200 group-hover:-translate-x-0.5">
                    <path d="m14.5 5-7 7 7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                  </svg>
                </button>
                <button type="button" data-carousel-next aria-label="Próximo post" class="group flex h-11 w-11 items-center justify-center rounded-full border border-white/70 bg-white/85 text-marine shadow-lg backdrop-blur-md transition duration-200 hover:scale-105 hover:border-white hover:bg-white hover:text-[#A8432F] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta focus-visible:ring-offset-2 focus-visible:ring-offset-white/50 active:scale-95">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 transition-transform duration-200 group-hover:translate-x-0.5">
                    <path d="m9.5 5 7 7-7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                  </svg>
                </button>
              </div>
            )}
          </div>
          <div class="flex min-h-0 flex-1 flex-col overflow-hidden p-6 sm:p-8">
            <p class="mb-3 line-clamp-1 text-sm font-bold uppercase tracking-[0.14em] text-[#A8432F]">{post.data.section}</p>
            {/* Sem altura reservada de propósito. Cheguei a reservar duas
                linhas de título e três de resumo para igualar os slides, e o
                resultado foi pior: quando o título ocupa uma linha só, os
                90 px reservados viram um vão entre o título e o resumo, no
                meio da leitura. O vão no fim do card, que era de cerca de
                50 px, incomoda menos do que um vão no meio. */}
            <a href={`/posts/${post.slug}/`} class="line-clamp-2 text-3xl font-black leading-tight text-marine hover:text-[#A8432F] sm:text-4xl">
              {post.data.title}
            </a>
            <p class="mt-4 line-clamp-3 text-base leading-7 text-slate-600">{post.data.excerpt}</p>
            {/* Sem mt-auto: com ele a data era empurrada para o fim do card e
                se soltava do resumo. Agora ela fica logo abaixo, e a sobra cai
                no fim do bloco, junto do respiro das bolinhas. */}
            <div class="flex flex-wrap items-center gap-3 pt-4 text-sm text-slate-500">
              <span>{dataLegivel(post.data.date)}</span>
              <span>•</span>
              <span>{tempoDeLeitura(post.body)}</span>
            </div>
          </div>
        </article>
      ))}
      {carouselPosts.length > 1 && (
        <nav aria-label="Controles do carrossel" class="col-start-1 row-start-2 flex h-[52px] items-center justify-center">
          <div class="flex items-center gap-1" role="group" aria-label="Selecionar post">
            {carouselPosts.map((post: CollectionEntry<'posts'>, index: number) => (
              <button
                type="button"
                data-carousel-indicator={index}
                aria-label={`Mostrar post ${index + 1}: ${post.data.title}`}
                aria-current={index === 0 ? 'true' : undefined}
                class="flex h-6 w-6 items-center justify-center rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta focus-visible:ring-offset-2"
              >
                <span
                  data-carousel-dot
                  class:list={[
                    'h-2.5 rounded-full transition-all',
                    index === 0 ? 'w-6 bg-terracotta' : 'w-2.5 bg-slate-300'
                  ]}
                ></span>
              </button>
            ))}
          </div>
        </nav>
      )}
      <p data-carousel-status class="sr-only" aria-live="off">Post 1 de {carouselPosts.length}</p>
    </div>

    <aside class="relative isolate flex flex-col overflow-hidden rounded-[30px] border border-[#b9cfbb] bg-[#dcebdd] p-7 shadow-soft sm:p-8">
      <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-2 bg-gradient-to-r from-terracotta via-mustard to-terracotta"></div>
      <div aria-hidden="true" class="absolute -right-12 -top-14 -z-10 h-40 w-40 rounded-full border-[24px] border-cream"></div>
      <!-- h1 da home. Antes a página não tinha nenhum h1: o título do carrossel
           é um <a> e o primeiro heading do DOM era este h2. Ele já usa
           font-serif, então promover para h1 não muda nada visualmente. -->
      <h1 class="mt-4 max-w-xs font-serif text-3xl font-bold leading-tight text-marine">Uma boa ideia cabe em poucos minutos.</h1>
      <p class="mt-4 text-sm leading-7 text-slate-600">
        Conteúdo curto, confiável e útil para quem quer aprender algo sem perder tempo.
      </p>
      <div class="mt-6 flex items-center gap-3 border-t border-slate-100 pt-5">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-terracotta/10 text-[#A8432F]" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-[1.8]">
            <path d="M12 3v2m0 14v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M3 12h2m14 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
            <circle cx="12" cy="12" r="4" />
          </svg>
        </span>
        <p class="text-xs leading-5 text-slate-600">Uma pausa leve para descobrir algo novo.</p>
      </div>
      <a href="/busca/" class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-marine px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-[#2b3a5b] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta focus-visible:ring-offset-2">
        Explorar
        <span aria-hidden="true">→</span>
      </a>
    </aside>
  </section>

  {siteConfig.adsEnabled && (
    <div class="mb-10 flex items-center justify-center">
      <div class="ad-slot h-24 w-full max-w-5xl">Publicidade</div>
    </div>
  )}

  {/* Os chips de categoria saíram daqui. Eles repetiam as quatro seções que o
      menu do topo já lista — e o cabeçalho é sticky, então essas mesmas quatro
      ficam fixas na tela o tempo todo. No celular eram a terceira apresentação
      das mesmas seções na mesma página, contando com o rodapé logo abaixo.
      Sem eles, o primeiro card de conteúdo sobe cerca de 90 px. */}

  <div class:list={['grid gap-8', siteConfig.adsEnabled && 'xl:grid-cols-[minmax(0,1fr)_300px]']}>
    <section>
      <div class="mb-6 flex items-center justify-between gap-3">
        <h2 class="text-3xl font-black text-marine">Posts recentes</h2>
        <a href="/busca/" class="text-sm font-semibold text-[#A8432F]">Ver todas as matérias →</a>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {recentPosts.map((post: CollectionEntry<'posts'>) => (
          <article class="overflow-hidden rounded-[24px] border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:border-terracotta/30 hover:shadow-soft">
            <img src={post.data.image} srcset={srcsetDe(post.data.image) ?? undefined} sizes={SIZES.cardDuasColunas} alt={post.data.imageAlt ?? post.data.title} class="aspect-[16/9] w-full object-cover" loading="lazy" decoding="async" />
            <div class="p-6">
              <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[#A8432F]">{post.data.section}</p>
              <a href={`/posts/${post.slug}/`} class="mt-3 block text-2xl font-black leading-tight text-marine hover:text-[#A8432F]">
                {post.data.title}
              </a>
              <p class="mt-4 text-sm leading-7 text-slate-600">{post.data.excerpt}</p>
              <div class="mt-5 flex flex-wrap items-center gap-3 text-xs text-slate-500">
                <span>{dataLegivel(post.data.date)}</span>
                <span>•</span>
                <span>{tempoDeLeitura(post.body)}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    {siteConfig.adsEnabled && (
      <aside class="hidden xl:block">
        <div class="ad-slot sticky top-28 h-[520px]">Publicidade</div>
      </aside>
    )}
  </div>

  {siteConfig.adsEnabled && <div class="ad-slot mt-10 h-28 w-full">Publicidade</div>}
</BaseLayout>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-post-carousel]');

  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const indicators = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-indicator]'));
    const status = carousel.querySelector<HTMLElement>('[data-carousel-status]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeIndex = 0;
    let interval: number | undefined;
    let pointerInside = false;

    const syncAutoplay = () => {
      window.clearInterval(interval);
      interval = undefined;

      if (slides.length > 1 && !pointerInside && !carousel.matches(':focus-within') && !document.hidden && !reducedMotion.matches) {
        interval = window.setInterval(() => showSlide(activeIndex + 1), 6000);
      }
    };

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        // visibility em vez do atributo hidden: os slides inativos continuam
        // ocupando espaço, que é o que mantém a altura do carrossel estável
        // quando o slide ativo muda. visibility: hidden já tira o elemento da
        // árvore de acessibilidade e do alcance do teclado.
        slide.classList.toggle('invisible', !isActive);
        slide.classList.toggle('opacity-0', !isActive);
        slide.classList.toggle('pointer-events-none', !isActive);

        // Materializa a imagem do slide que entrou. Os inativos não têm src,
        // para o navegador não baixar as cinco imagens do carrossel de uma vez.
        if (isActive) {
          const imagem = slide.querySelector<HTMLImageElement>('img[data-src]');
          if (imagem) {
            const src = imagem.dataset.src;
            const srcset = imagem.dataset.srcset;
            if (src) imagem.src = src;
            if (srcset) imagem.srcset = srcset;
            imagem.removeAttribute('data-src');
            imagem.removeAttribute('data-srcset');
          }
        }
      });

      indicators.forEach((indicator, indicatorIndex) => {
        const isActive = indicatorIndex === activeIndex;
        // O botão é o alvo de toque (24x24, para caber no mínimo do WCAG 2.2
        // SC 2.5.8); a bolinha visível é o span interno.
        const dot = indicator.querySelector<HTMLElement>('[data-carousel-dot]');
        indicator.setAttribute('aria-current', String(isActive));

        if (!dot) return;
        dot.classList.toggle('w-6', isActive);
        dot.classList.toggle('bg-terracotta', isActive);
        dot.classList.toggle('w-2.5', !isActive);
        dot.classList.toggle('bg-slate-300', !isActive);
      });

      if (status) {
        status.textContent = `Post ${activeIndex + 1} de ${slides.length}`;
      }
    };

    carousel.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }

      const button = event.target.closest<HTMLButtonElement>('button');
      if (!button || !carousel.contains(button)) {
        return;
      }

      if (button.matches('[data-carousel-prev]')) {
        showSlide(activeIndex - 1);
        syncAutoplay();
      } else if (button.matches('[data-carousel-next]')) {
        showSlide(activeIndex + 1);
        syncAutoplay();
      } else if (button.matches('[data-carousel-indicator]')) {
        const index = Number(button.dataset.carouselIndicator);
        if (Number.isInteger(index)) {
          showSlide(index);
          syncAutoplay();
        }
      }
    });

    carousel.addEventListener('mouseenter', () => {
      pointerInside = true;
      syncAutoplay();
    });

    carousel.addEventListener('mouseleave', () => {
      pointerInside = false;
      syncAutoplay();
    });

    carousel.addEventListener('focusin', syncAutoplay);
    carousel.addEventListener('focusout', () => {
      window.setTimeout(syncAutoplay, 0);
    });

    document.addEventListener('visibilitychange', syncAutoplay);
    reducedMotion.addEventListener('change', syncAutoplay);
    syncAutoplay();
  }
</script>
