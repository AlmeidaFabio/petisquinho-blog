---
import Paginacao from './Paginacao.astro';
import { srcsetDe, SIZES } from '../utils/images';
import type { PaginaDeCategoria } from '../utils/categorias';
import { dataLegivel, tempoDeLeitura } from '../utils/posts';

interface Props {
  listagem: PaginaDeCategoria;
}

const { listagem } = Astro.props;
const { categoria, posts, pagina, totalPaginas, totalPosts } = listagem;
---

<section>
  <p class="mb-3 text-sm font-semibold uppercase tracking-[0.15em] text-[#A8432F]">
    {pagina === 1 ? 'Categoria' : `Categoria · página ${pagina} de ${totalPaginas}`}
  </p>
  <h1 class="text-4xl font-black text-marine">{categoria.label}</h1>
  <p class="mt-3 text-sm text-slate-600">
    {totalPosts === 1 ? '1 matéria publicada' : `${totalPosts} matérias publicadas`}
    {totalPaginas > 1 && ` · ${posts.length} nesta página`}
  </p>

  {posts.length === 0 ? (
    <p class="mt-8 rounded-3xl border border-slate-200 bg-white p-8 text-center text-sm text-slate-600">
      Ainda não há matérias nesta categoria.
    </p>
  ) : (
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {posts.map((post, index) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          {/* A primeira capa da página é o elemento de LCP em qualquer página da
              listagem, não só na primeira: por isso ela é eager e com
              fetchpriority, e o preload correspondente sai no <head>. */}
          <img
            src={post.data.image}
            srcset={srcsetDe(post.data.image) ?? undefined}
            sizes={SIZES.cardDuasColunas}
            alt={post.data.imageAlt ?? post.data.title}
            class="mb-5 aspect-[16/9] w-full rounded-2xl object-cover"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
            decoding="async"
          />
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#A8432F]">{post.data.section}</p>
          <a href={`/posts/${post.slug}/`} class="mt-3 block text-2xl font-black text-marine hover:text-[#A8432F]">{post.data.title}</a>
          <p class="mt-4 text-sm leading-7 text-slate-600">{post.data.excerpt}</p>
          <div class="mt-4 flex items-center gap-3 text-xs text-slate-500">
            <span>{dataLegivel(post.data.date)}</span>
            <span>•</span>
            <span>{tempoDeLeitura(post.body)}</span>
          </div>
        </article>
      ))}
    </div>
  )}

  <Paginacao slug={categoria.slug} rotulo={categoria.label} pagina={pagina} totalPaginas={totalPaginas} />
</section>
