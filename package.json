{
  "name": "petisquinho-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "node scripts/check-image-formats.mjs && node scripts/generate-og-images.mjs && astro build",
    "preview": "astro preview --host",
    "prepare:deploy": "node scripts/prepare-deploy.mjs",
    "deploy": "npm run prepare:deploy && npm run build && node --env-file=.env scripts/deploy-hostgator.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@astrojs/tailwind": "^5.0.0",
    "astro": "^5.0.0",
    "basic-ftp": "^6.2.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
