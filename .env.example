# Credenciais de deploy FTPS para a HostGator.
#
# Como usar:
#   PowerShell:  Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env
#
# Depois preencha o .env com seus dados. O arquivo .env está no .gitignore
# e nunca deve ser commitado — ele contém a senha do FTP.

# Host FTPS. Use o hostname informado pela HostGator.
# Se o painel fornecer um IP, preencha também HOSTGATOR_TLS_SERVERNAME abaixo.
HOSTGATOR_HOST=ftp.seudominio.com

# Padrão: 21. Este projeto usa FTPS explícito (FTP sobre TLS), não SFTP.
HOSTGATOR_PORT=21

HOSTGATOR_USER=seu_usuario_ftp
HOSTGATOR_PASSWORD=sua_senha_ftp

# Caminho remoto relativo à raiz visível da conta FTP.
# Use / quando a conta FTP já está limitada à raiz pública do domínio.
# Use /public_html quando a conta FTP começa na pasta pessoal.
HOSTGATOR_REMOTE_PATH=/

# Nome DNS do certificado FTPS. Obrigatório quando HOSTGATOR_HOST é um IP,
# caso contrário o Node.js rejeita o certificado.
# A validação do certificado não deve ser desativada.
HOSTGATOR_TLS_SERVERNAME=hostgator.com.br
