# ============================================================
#  Petisquinho — configuração do servidor (HostGator / Apache-LiteSpeed)
#
#  Este arquivo vive em public/ e é copiado para a raiz do site no build.
#  Verificado em 14/10/2026 com uma sonda em /teste-cabecalhos/: a hospedagem
#  aceita mod_headers e mod_rewrite, então as diretivas abaixo funcionam.
#
#  Tudo está dentro de <IfModule> de propósito: se um módulo não existir na
#  hospedagem, o bloco é ignorado em vez de derrubar o site com erro 500.
# ============================================================

# ------------------------------------------------------------
#  1. Cabeçalhos de segurança
# ------------------------------------------------------------
<IfModule mod_headers.c>
  # HSTS: 1 ano. Sem includeSubDomains e sem preload, por decisão consciente.
  # O simula-prova.petisquinho.com ainda não existe; se ele nascer sem HTTPS
  # válido, um HSTS herdado tornaria o app inacessível — o navegador recusa a
  # conexão e não oferece "continuar mesmo assim". Reavaliar depois de
  # confirmar que webmail e cpanel funcionam bem em HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # CSP: tudo restrito à própria origem, exceto 'unsafe-inline' em script e
  # style. Essa exceção é necessária porque todos os scripts do site são
  # inline (carrossel da home, busca, copiar link) — não há /_astro/*.js.
  # O domínio cloudflareinsights.com está previsto para o analytics sem
  # cookies ainda não instalado, para a CSP não quebrar o site quando entrar.
  # frame-ancestors só funciona em cabeçalho HTTP, não em <meta>.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; upgrade-insecure-requests"
</IfModule>

# ------------------------------------------------------------
#  2. HTTPS e domínio único
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https, apenas quando o visitante realmente veio em http, conforme
  # o Cloudflare informa em X-Forwarded-Proto.
  #
  # De propósito NÃO usa %{HTTPS}: atrás do proxy essa variável reflete a
  # conexão Cloudflare->origem, não a do visitante. Uma regra baseada nela
  # redirecionaria para sempre (loop) quando o modo SSL fosse Flexible.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
  RewriteRule ^(.*)$ https://petisquinho.com/$1 [R=301,L]

  # www -> raiz. Depende só do Host, que o Cloudflare preserva.
  RewriteCond %{HTTP_HOST} ^www\.petisquinho\.com$ [NC]
  RewriteRule ^(.*)$ https://petisquinho.com/$1 [R=301,L]
</IfModule>

# ------------------------------------------------------------
#  3. Limpeza de arquivos que saíram do repositório
#
#  O deploy envia a build mas não apaga no servidor o que deixou de existir
#  localmente. Os redirects abaixo tornam inalcançável o que já saiu do site,
#  sem exigir acesso ao Gerenciador de Arquivos.
#
#  Atenção ao remover: o bloco do mod_rewrite e a regra da sonda são
#  temporários e podem sair depois de apagar no cPanel
#  (public_html/teste-cabecalhos/ e as duas capas .jpg). O redirecionamento do
#  post do café, que fica no mesmo bloco do mod_alias, é permanente.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Capas que saíram do repositório e que o deploy não apagou no servidor:
  #   - os dois JPEG substituídos por WebP (4,0 MB de arquivos mortos)
  #   - o ceu-azul.svg, que nenhum post referenciava (o post do céu usa o .webp)
  #   - a capa do post "Chegou bem?", despublicado pelo autor em 15/10/2026
  #
  # 410 (Gone) em vez de 404 diz ao Google que o arquivo foi removido de vez.
  # Sem estas regras eles continuariam respondendo 200 em produção, porque o
  # deploy envia a build mas não remove o que deixou de existir localmente.
  RewriteRule ^images/posts/ceu-azul\.(jpg|svg)$ - [G,L]
  RewriteRule ^images/posts/cheiro-de-terra-molhada\.jpg$ - [G,L]
  RewriteRule ^images/posts/chegou-bem\.webp$ - [G,L]
  RewriteRule ^og/chegou-bem\.jpg$ - [G,L]
</IfModule>

<IfModule mod_alias.c>
  # Sonda de cabeçalhos usada para testar o suporte a .htaccess.
  #
  # RedirectMatch (mod_alias) em vez de RewriteRule de propósito: em .htaccess,
  # o RewriteRule casa com o caminho relativo ao diretório, e para uma pasta que
  # existe e tem .htaccess próprio essa resolução não se comportou como
  # esperado — a regra simplesmente não disparou. O RedirectMatch casa com o
  # caminho completo da URL, com a barra inicial, em qualquer contexto.
  RedirectMatch 301 ^/teste-cabecalhos(/.*)?$ /

  # Post "Chegou bem?", despublicado pelo autor em 15/10/2026.
  #
  # A página já esteve no ar, então continua existindo como diretório no
  # servidor e responderia 200 com um conteúdo que o autor tirou do site. O 410
  # diz ao buscador que a remoção é definitiva — 404 sugeriria que o endereço
  # pode voltar.
  #
  # RedirectMatch porque é um diretório que ainda existe no servidor, o mesmo
  # caso que não funcionou com RewriteRule na sonda de cabeçalhos.
  RedirectMatch gone ^/posts/chegou-bem(/.*)?$

  # Slug do post do café renomeado (P1-8).
  #
  # O endereço antigo perguntava "por que as pessoas falam em café com leite?",
  # mas o texto responde por que o café muda tanto de sabor — a pergunta nunca
  # era respondida em lugar nenhum. O endereço passou a ser
  # /posts/por-que-o-cafe-muda-tanto-de-sabor/ e o antigo fica redirecionado em
  # definitivo, para não deixar 404 em link já compartilhado nem no que o Google
  # indexou enquanto o endereço antigo esteve no ar.
  #
  # O /? opcional cobre as duas formas, com e sem barra final.
  RedirectMatch 301 ^/posts/por-que-as-pessoas-falam-em-cafe-com-leite/?$ /posts/por-que-o-cafe-muda-tanto-de-sabor/
</IfModule>

# ------------------------------------------------------------
#  4. Página 404 própria
# ------------------------------------------------------------
# ErrorDocument é do core do Apache, então não fica dentro de <IfModule>.
#
# Sem esta linha o HostGator serve a página de erro padrão dele (/cgi-sys/...),
# que tem a marca da hospedagem e um convite para contratar plano. O arquivo
# 404.html é gerado pelo Astro a partir de src/pages/404.astro.
#
# O status continua sendo 404 (não 200), o que mantém a página fora do índice
# de busca — o meta robots noindex é só reforço.
ErrorDocument 404 /404.html

# ------------------------------------------------------------
#  5. Cache dos arquivos estáticos
# ------------------------------------------------------------
# O HostGator já envia um Cache-Control próprio (era 4 h para CSS e 24 h para
# imagem). "Header set" substitui o valor em vez de acrescentar outro.
#
# O HTML fica de fora de propósito: ele precisa continuar sendo revalidado,
# porque a home e as categorias mudam quando um post novo entra.
<IfModule mod_headers.c>
  # CSS e JS do build carregam hash de conteúdo no nome
  # (ex.: busca.CPfNWCbS.css), então a mesma URL nunca muda de conteúdo.
  <FilesMatch "\.(css|js)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imagens e ícones têm nome estável: trocar a capa de um post mantém a URL.
  # Por isso o cache é longo, mas não imutável — assim um recarregamento
  # normal ainda pode revalidar.
  <FilesMatch "\.(webp|avif|svg|png|jpe?g|gif|ico|woff2?)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
